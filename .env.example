# forthree — optional local environment variables
# Copy to .env.local only when needed. Never commit .env.local or a real key.
# The MVP runs without these values. Its assistant currently returns static
# fallback text; provider calls and spend enforcement are not connected yet.

# Reserved for the optional server-side assistant.
OPENROUTER_API_KEY=

# Spending caps for the assistant, in US dollars. Over a cap it falls back to
# static text; it never errors.
LLM_DAILY_CAP_USD=1.00
LLM_MONTHLY_CAP_USD=25.00
